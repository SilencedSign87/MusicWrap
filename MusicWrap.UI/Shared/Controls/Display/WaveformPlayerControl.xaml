<UserControl x:Class="MusicWrap.UI.Controls.WaveformPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d"
             x:Name="RootWaveformControl"
             d:DesignHeight="100" d:DesignWidth="800"
             SizeChanged="UserControl_SizeChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             SnapsToDevicePixels="True"
             Focusable="True"
             >
    <Border>
        <Grid 
            x:Name="WaveformContainer"
            Cursor="Hand"
              >
            <!-- Back waveform -->
            <Path x:Name="PathBackground" 
                  Fill="{Binding Foreground, ElementName=RootWaveformControl}"
                  Stretch="None" 
                  Opacity="0.3"/>
            <!-- Front filled waveform -->
            <Path x:Name="PathForeground" 
                  Fill="{Binding Foreground, ElementName=RootWaveformControl}"
                  Stretch="None"
                  >
                <Path.Clip>
                    <RectangleGeometry x:Name="ProgressClip" Rect="0,0,0,0"/>
                </Path.Clip>
            </Path>

            <Line x:Name="PositionThumb"
              Fill="{Binding Foreground, ElementName=RootWaveformControl}"
              StrokeThickness="1"
              IsHitTestVisible="False"
              Visibility="Collapsed"
            />
            <Popup
                x:Name="SeekPopup"
                Placement="Relative"
                PlacementTarget="{Binding ElementName=WaveformContainer}"
                StaysOpen="True"
                AllowsTransparency="True"
                IsHitTestVisible="False"
                IsOpen="False"
                >
                <Border 
                    Background="{DynamicResource BackgroundFloating}" 
                    BorderThickness="1" 
                    BorderBrush="{DynamicResource StrokeFloating}"
                    CornerRadius="4"
                    Padding="8,4"
                    >
                    <TextBlock x:Name="SeekPopupText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Text="0:00" />
                </Border>
            </Popup>

            <!-- Interactive layer-->
            <Rectangle 
                Fill="Transparent"
                MouseDown="Rectangle_MouseDown"
                MouseMove="Rectangle_MouseMove"
                MouseUp="Rectangle_MouseUp"
                MouseRightButtonDown="Rectangle_MouseRightButtonDown"
                   />
        </Grid>
    </Border>
</UserControl>


