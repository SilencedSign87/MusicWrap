<UserControl x:Class="MusicWrap.UI.Controls.BarVisualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="400"
             SizeChanged="OnSizeChanged"
             >
    <Grid x:Name="BarContainer">
       <Canvas x:Name="CanvasForeground">
            <Canvas.Clip>
                <RectangleGeometry x:Name="ProgressClip" Rect="0,0,0,0"/>
            </Canvas.Clip>

            <Path x:Name="SpectrumFillPath" IsHitTestVisible="False"/>
            <Path x:Name="SpectrumTopPath" IsHitTestVisible="False"/>
        </Canvas>
    </Grid>
</UserControl>
