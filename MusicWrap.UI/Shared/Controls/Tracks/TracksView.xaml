<UserControl x:Class="MusicWrap.UI.Controls.Models.TracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:data="clr-namespace:MusicWrap.Core.Services.Library;assembly=MusicWrap.Core"
             xmlns:local="clr-namespace:MusicWrap.UI.Controls.Models"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:converters="clr-namespace:MusicWrap.UI.Converters"
             mc:Ignorable="d" 
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ForegroundIsLightConverter x:Key="ForegroundIsLightConverter"/>
        <converters:ForegroundToHoverBrushConverter x:Key="ForegroundToHoverBrushConverter"/>
        <converters:ItemCountToColumnsConverter x:Key="ItemCountToColumnsConverter"/>
        <converters:TrackPlayingToVisibilityConverter x:Key="TrackPlayingToVisibilityConverter"/>
        <converters:TrackPlayingSlotVisibilityConverter x:Key="TrackPlayingSlotVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:DiskNumberToGroupHeaderConverter x:Key="DiskNumberToGroupHeaderConverter"/>
        <ItemsPanelTemplate x:Key="VirtualizedItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ColumnFlowItemsPanel">
            <ex:ColumnFlowPanel 
                ex:ColumnFlowPanel.Columns="{Binding ElementName=Root, Path=ColumnFlowColumns}"
                />
        </ItemsPanelTemplate>

        <!-- Primitives -->
        <!-- Playing now indicator -->
        <Style x:Key="TrackPlayingIconBaseStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="Text" Value="&#xE767;"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- Index number -->
        <Style x:Key="TrackIndexNumberStyle" TargetType="TextBlock">
            <Setter Property="Text" Value=""/>
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Root, Path=IndexMode}" Value="{x:Static local:TrackIndexDisplayMode.ListIndex}">
                    <Setter Property="Text" Value="{Binding ListIndex}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=Root, Path=IndexMode}" Value="{x:Static local:TrackIndexDisplayMode.TrackNumber}">
                    <Setter Property="Text" Value="{Binding TrackNumberDisplay}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Duration indicator -->
        <Style x:Key="TrackDurationStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Slots -->
        <DataTemplate x:Key="TrackIndexSlotTemplate" DataType="data:TrackRowItem">
            <Grid>
                <TextBlock Style="{StaticResource TrackIndexNumberStyle}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource TrackPlayingSlotVisibilityConverter}" ConverterParameter="Index:negative">
                            <Binding ElementName="Root" Path="CurrentTrackId"/>
                            <Binding Path="Id"/>
                            <Binding ElementName="Root" Path="IsPlaybackActive"/>
                            <Binding ElementName="Root" Path="IndexMode"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Style="{StaticResource TrackPlayingIconBaseStyle}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource TrackPlayingSlotVisibilityConverter}" ConverterParameter="Index">
                            <Binding ElementName="Root" Path="CurrentTrackId"/>
                            <Binding Path="Id"/>
                            <Binding ElementName="Root" Path="IsPlaybackActive"/>
                            <Binding ElementName="Root" Path="IndexMode"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TrackDurationSlotTemplate" DataType="data:TrackRowItem">
            <Grid>
                <TextBlock Text="{Binding DurationText}" Style="{StaticResource TrackDurationStyle}" Margin="16,0,0,0" HorizontalAlignment="Right">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource TrackPlayingSlotVisibilityConverter}" ConverterParameter="Duration:negative">
                            <Binding ElementName="Root" Path="CurrentTrackId"/>
                            <Binding Path="Id"/>
                            <Binding ElementName="Root" Path="IsPlaybackActive"/>
                            <Binding ElementName="Root" Path="IndexMode"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <TextBlock Style="{StaticResource TrackPlayingIconBaseStyle}">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource TrackPlayingSlotVisibilityConverter}" ConverterParameter="Duration">
                            <Binding ElementName="Root" Path="CurrentTrackId"/>
                            <Binding Path="Id"/>
                            <Binding ElementName="Root" Path="IsPlaybackActive"/>
                            <Binding ElementName="Root" Path="IndexMode"/>
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ListBox and ListView Styles -->

        <Style x:Key="TracksListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="ItemsPanel" Value="{StaticResource VirtualizedItemsPanel}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Root, Path=UseColumnFlowPanel}" Value="True">
                    <Setter Property="ItemsPanel" Value="{StaticResource ColumnFlowItemsPanel}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ElementName=Root, Path=IsMouseWheelScrollEnabled}" Value="True">
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrackItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0,1,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ElementName=Root, Path=Foreground}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border
                                x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                />

                            <Border
                                x:Name="HoverOverlay"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                CornerRadius="4"
                                Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground, Converter={StaticResource ForegroundToHoverBrushConverter}}"/>

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- Explicit override -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=Root, Path=SelectedBackground, Converter={StaticResource NullToBoolConverter}}"  Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{Binding ElementName=Root, Path=SelectedBackground}"/>
                    <Setter Property="Foreground" Value="{Binding ElementName=Root, Path=SelectedForeground}"/>
                </MultiDataTrigger>
                <!-- Autodetected - light foreground -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=Root, Path=SelectedBackground, Converter={StaticResource NullToBoolConverter}}" Value="False"/>
                        <Condition Binding="{Binding ElementName=Root, Path=Foreground, Converter={StaticResource ForegroundIsLightConverter}}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFFFFFF"/>
                    <Setter Property="Foreground" Value="#FF000000"/>
                </MultiDataTrigger>
                <!-- Autodetected - dark foreground -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ElementName=Root, Path=SelectedBackground, Converter={StaticResource NullToBoolConverter}}" Value="False"/>
                        <Condition Binding="{Binding ElementName=Root, Path=Foreground, Converter={StaticResource ForegroundIsLightConverter}}" Value="False"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FF000000"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </MultiDataTrigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="TrackGroupItemStyle" TargetType="GroupItem">
            <Setter Property="Foreground" Value="{Binding ElementName=Root, Path=Foreground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel Margin="0,0,0,10">
                            <Border Margin="0"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    >
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           Text="{Binding Name, Converter={StaticResource DiskNumberToGroupHeaderConverter}}"/>
                            </Border>
                            <Border Height="1" Background="{Binding ElementName=Root, Path=Foreground}" Opacity="0.25" Margin="0,8"/>
                            <ItemsPresenter />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View mode templates -->

        <DataTemplate x:Key="TrackCompactNoCoverTemplate" DataType="local:TrackRowItem">
            <Grid Margin="0,2" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <!-- playing indicador / index-->
                    <ColumnDefinition Width="32"/>
                    <!-- Title and info -->
                    <ColumnDefinition Width="*"/>
                    <!-- Duration -->
                    <ColumnDefinition Width="Auto" MinWidth="50"/>
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource TrackIndexSlotTemplate}" />
                <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding ArtistNames}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource TrackDurationSlotTemplate}" Margin="8,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrackWithCoverArtTemplate" DataType="local:TrackRowItem">
            <Grid Margin="2" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="Auto" MaxWidth="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="50"/>
                </Grid.ColumnDefinitions>

                <Image
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        Source="{Binding CoverAssetPath, Converter={StaticResource PathToImageConverter}, ConverterParameter=42}" />

               <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource TrackIndexSlotTemplate}" />

                <Grid Grid.Column="2" HorizontalAlignment="Stretch" Margin="8,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Grid.Row="1" Text="{Binding ArtistNames}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>

                <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource TrackDurationSlotTemplate}" Margin="8,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrackListImageTemplate" DataType="local:TrackRowItem">
            <Grid Margin="1" Cursor="Hand" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition MaxWidth="200"/>
                    <ColumnDefinition MaxWidth="200"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="2" VerticalAlignment="Center" ClipToBounds="True">
                    <Image Source="{Binding CoverAssetPath, Converter={StaticResource PathToImageConverter}, ConverterParameter=20}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality"/>
                </Border>
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource TrackIndexSlotTemplate}" />

                <TextBlock Grid.Column="2" Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding ArtistNames}" VerticalAlignment="Center" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="4" Text="{Binding AlbumName}" VerticalAlignment="Center" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                
                <ContentPresenter Grid.Column="5" Content="{Binding}" ContentTemplate="{StaticResource TrackDurationSlotTemplate}" Margin="8,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListView x:Name="TracksList" 
                 ItemContainerStyle="{StaticResource TrackItemContainerStyle}" 
                 ItemsSource="{Binding ElementName=Root, Path=ItemsSource}" 
                 SelectionMode="{Binding ElementName=Root, Path=SelectionMode}" 
                 ContextMenu="{Binding ElementName=Root, Path=ContextMenu}"
                 AllowDrop="{Binding ElementName=Root, Path=IsReorderEnabled}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="TracksList_SelectionChanged"
                 MouseDoubleClick="TracksList_MouseDoubleClick" 
                 KeyDown="TracksList_KeyDown" 
                 PreviewMouseLeftButtonDown="TracksList_PreviewMouseLeftButtonDown"
                 MouseMove="TracksList_MouseMove"
                 DragOver="TracksList_DragOver"
                 Drop="TracksList_Drop"
                 PreviewMouseWheel="TracksList_PreviewMouseWheel"
                 PreviewMouseRightButtonDown="TracksList_PreviewMouseRightButtonDown"
                 Background="Transparent" BorderThickness="0">
            <ListView.Style>
                <Style TargetType="ListView" BasedOn="{StaticResource TracksListBoxStyle}">
                    <Setter Property="ItemTemplate" Value="{StaticResource TrackCompactNoCoverTemplate}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=Root, Path=VisualMode}" Value="{x:Static local:TrackVisualMode.WithCoverArt}">
                            <Setter Property="ItemTemplate" Value="{StaticResource TrackWithCoverArtTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=Root, Path=VisualMode}" Value="{x:Static local:TrackVisualMode.ListImage}">
                            <Setter Property="ItemTemplate" Value="{StaticResource TrackListImageTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem" BasedOn="{StaticResource TrackGroupItemStyle}"/>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
    </Grid>
</UserControl>

