<UserControl x:Class="MusicWrap.UI.Controls.TokenizingTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Controls"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="200"
             Focusable="False"
             x:Name="Root"
             >
    <UserControl.Resources>
        <DataTemplate x:Key="DefaultTokenTemplate">
            <Border
                Padding="8,0,0,0"
                CornerRadius="4"
                Height="26"
                BorderThickness="1"
                BorderBrush="{DynamicResource StrokeControl}">

                <Grid ColumnDefinitions="*,8,Auto">

                    <TextBlock 
                        Grid.Column="0"
                        Text="{Binding}"
                        VerticalAlignment="Center" />

                    <local:AppButton
                        Grid.Column="2"
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE894;"
                        Padding="4"
                        IsSquare="True"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Focusable="False"
                        Click="RemoveTokenButton_Click" />

                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Border
            MinHeight="34"
            x:Name="RootBorder"
            Padding="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource StrokeControlGradient}"
            Background="{DynamicResource BackgroundControlDefault}"
            CornerRadius="2"
            >
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                CanContentScroll="False">
                <local:TokenizingPanel x:Name="TokenPanel" VerticalAlignment="Center">
                    <local:AppInput
                        x:Name="Input"
                        Style="{StaticResource SubtleAppInputStyle}"
                        MinWidth="100"
                        Height="26"
                        VerticalAlignment="Center"
                        PlaceholderText="{Binding PlaceholderText, ElementName=Root}"
                        Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        EnterPressed="Input_EnterPressed"
                        TextChanged="Input_TextChanged"/>
                </local:TokenizingPanel>
            </ScrollViewer>
        </Border>

        <Popup x:Name="SuggestionsPopup"
           PlacementTarget="{Binding ElementName=Input}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           IsOpen="{Binding IsSuggestionListOpen, ElementName=Root, Mode=TwoWay}">
            <Border MinWidth="220"
                    MaxHeight="260"
                    Background="{DynamicResource BackgroundFloating}"
                    BorderBrush="{DynamicResource StrokeFloating}"
                    BorderThickness="1"
                    CornerRadius="8"
                    >
                     <!--ItemsSource="{Binding AutocompleteSource,
                         RelativeSource={RelativeSource AncestorType={x:Type local:TokenizingTextBox}}}"-->
                <ListBox x:Name="SuggestionsList"
                         DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
                         SelectionChanged="SuggestionsList_SelectionChanged"
                         MouseDoubleClick="SuggestionsList_MouseDoubleClick"
                         PreviewKeyDown="SuggestionsList_PreviewKeyDown"
                         Background="Transparent"
                         />
            </Border>
        </Popup>
    </Grid>
</UserControl>
