<UserControl x:Class="MusicWrap.UI.Shell.Windows.FullScreenWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicWrap.UI.Shell.Windows"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:lyrics="clr-namespace:MusicWrap.UI.Features.Lyrics.View"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:vm="clr-namespace:MusicWrap.UI.Shell.ViewModel"
             xmlns:converters="clr-namespace:MusicWrap.UI.Converters"
             mc:Ignorable="d"
             x:Name="RootFullScreenWindow"
             d:DataContext="{d:DesignInstance Type=vm:FullscreenWindowViewModel}"
             Loaded="RootFullScreenWindow_Loaded"
             Unloaded="RootFullScreenWindow_Unloaded"
             d:Width="1920"
             d:Height="1080"
             >
    <UserControl.Foreground>
        <SolidColorBrush Color="{Binding PlayerViewModel.CurrentTackDominantForegroundColorHex}" Opacity="0.8"/>
    </UserControl.Foreground>
    <UserControl.Background>
        <ImageBrush
             ImageSource="{Binding PlayerViewModel.CurrentTrackImagePath,
            Converter={StaticResource PathToImageConverter},
            ConverterParameter=blur:1080}"
            Stretch="UniformToFill"
            RenderOptions.BitmapScalingMode="HighQuality"
            AlignmentX="Center"
            AlignmentY="Center"
            />
    </UserControl.Background>
    <UserControl.Resources>
        <SolidColorBrush x:Key="BackdropTint" Color="#000000" Opacity="0.25"/>
        <SolidColorBrush x:Key="ControlForeground" Color="{Binding PlayerViewModel.CurrentTackDominantForegroundColorHex}" Opacity="0.8"/>
        <SolidColorBrush x:Key="ControlHoverForeground" Color="{Binding PlayerViewModel.CurrentTackDominantForegroundColorHex}" Opacity="0.1"/>

        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ControlForeground}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Height="{TemplateBinding Height}"
                            Width="{TemplateBinding Width}"
                            Background="{TemplateBinding Background}"
                            Padding="0"
                            Margin="0"
                            CornerRadius="8"
                            >
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHoverForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- MainContent -->
    <Grid x:Name="BackdropRoot" ClipToBounds="True">

        <Grid x:Name="MainContentGrid">
            <Grid 
                x:Name="ArtworkHost"
                HorizontalAlignment="Left" 
                ClipToBounds="True"
                RowDefinitions="*" 
                ColumnDefinitions="*">
                <StackPanel 
                    Grid.Column="0"
                    Grid.Row="0"
                    x:Name="ArtworkPanel"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,64,0,0"
                    MaxWidth="700"
                    >
                    <controls:ImageContainer 
                        x:Name="ArtworkBorder" 
                        Width="640" 
                        Height="640" 
                        Source="{Binding PlayerViewModel.CurrentTrackImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=original:900}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource StrokeSurface}"
                        SnapsToDevicePixels="True" 
                        />
                    <TextBlock 
                        Text="{Binding PlayerViewModel.CurrentTrackTitle}" 
                        TextAlignment="Center" 
                        FontSize="22" 
                        FontWeight="SemiBold" 
                        TextWrapping="NoWrap"
                        MaxWidth="600"
                        Margin="0,36,0,4"
                        />
                    <TextBlock 
                        TextAlignment="Center" 
                        FontSize="20" 
                        FontWeight="SemiBold" 
                        TextWrapping="NoWrap"
                        Opacity="0.5"
                        MaxWidth="600">
                        <Run Text="{Binding PlayerViewModel.CurrentTrackArtists }" />
                        <Run Text="·" />
                        <Run Text="{Binding PlayerViewModel.CurrentTrackAlbum}" />
                    </TextBlock>
                    <Grid x:Name="Mediacontrols" RowDefinitions="*,*" ColumnDefinitions="*" Margin="0,28,0,0" MaxWidth="400">
                        <Grid Grid.Row="0" ColumnDefinitions="auto,*,auto">
                            <TextBlock 
                                Grid.Column="0" 
                                Text="{Binding FormattedPosition, ElementName=ProgressBar, Mode=OneWay}" 
                                FontSize="16" 
                                Opacity="0.9"
                                />
                            <controls:WaveformPlayerControl
                                x:Name="ProgressBar"
                                Grid.Column="1"
                                Height="8"
                                Margin="8,0"
                                UsePlaceholderWaveform="True"
                                />
                            <TextBlock 
                                Grid.Column="2" 
                                Text="{Binding FormattedDuration, ElementName=ProgressBar, Mode=OneWay}" 
                                FontSize="16"
                                Opacity="0.9"
                                />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,*" HorizontalAlignment="Stretch" Margin="0,8,0,0">

                            <controls:AppMenu Grid.Column="6"  HorizontalAlignment="Right">
                                <controls:AppMenuItem 
                                    Icon="{ex:Icon Glyph=E712, FontSize=14}" 
                                    Height="40" Width="40">
                                    <controls:AppMenuItem 
                                        Icon="{ex:Icon Glyph=&#xE90F;}" 
                                        Header="Properties" 
                                        Command="{Binding PlayerViewModel.OpenPropertiesOfCurrentTrackCommand}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        />
                                    <controls:AppMenuItem Icon="{ex:Icon Glyph=&#xF61F;}" Header="Visualizer" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <controls:AppMenuItem Header="Off" IsCheckable="True" 
                                            Command="{Binding SetVisualizerCommand}"
                                            CommandParameter="None"
                                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=None}" />
                                        <controls:AppMenuItem Header="Line" IsCheckable="True" 
                                            Command="{Binding SetVisualizerCommand}"
                                            CommandParameter="LineSpectrum"
                                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=LineSpectrum}" />
                                        <controls:AppMenuItem Header="Bars" IsCheckable="True" 
                                            Command="{Binding SetVisualizerCommand}"
                                            CommandParameter="BarSpectrum"
                                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=BarSpectrum}" />
                                        <controls:AppMenuItem Header="Wave" IsCheckable="True"
                                            Command="{Binding SetVisualizerCommand}"
                                            CommandParameter="MirroredBarSpectrum"
                                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=MirroredBarSpectrum}" />
                                        <Separator/>
                                        <controls:AppMenuItem Header="Spectrum" IsCheckable="True"
                                            Command="{Binding SetSpectrumTypeCommand}"
                                            CommandParameter="Normal"
                                            IsChecked="{Binding PreferredSpectrumType, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=Normal}"
                                            />
                                        <controls:AppMenuItem Header="Centered" IsCheckable="True"
                                            Command="{Binding SetSpectrumTypeCommand}"
                                            CommandParameter="Centered"
                                            IsChecked="{Binding PreferredSpectrumType, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=Centered}"
                                            />
                                    </controls:AppMenuItem>
                                    <controls:AppMenuItem Icon="{ex:Icon Glyph=E90D}"  Header="Panel" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <controls:AppMenuItem 
                                            Icon="{ex:Icon Glyph=F5A6}"
                                            Header="None" 
                                            IsCheckable="True" 
                                            Command="{Binding SetPanelCommand}"
                                            CommandParameter="None"
                                            IsChecked="{Binding ActivePanel, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=None}"
                                            />
                                        <controls:AppMenuItem 
                                            Icon="{ex:Icon Glyph=EC4F}"
                                            Header="Lyrics" 
                                            IsCheckable="True" 
                                            Command="{Binding SetPanelCommand}"
                                            CommandParameter="Lyrics"
                                            IsChecked="{Binding ActivePanel, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=Lyrics}"
                                            />
                                        <controls:AppMenuItem
                                            Icon="{ex:Icon Glyph=E90B}"
                                            Header="Queue"
                                            IsCheckable="True"
                                            Command="{Binding SetPanelCommand}"
                                            CommandParameter="Queue"
                                            IsChecked="{Binding ActivePanel, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=Queue}"
                                            />
                                    </controls:AppMenuItem>
                                </controls:AppMenuItem>
                            </controls:AppMenu>

                            <Button 
                                Grid.Column="1"
                                Style="{StaticResource PlayerButton}" 
                                ToolTip="{Binding PlayerViewModel.RepeatModeTooltip}" 
                                Command="{Binding PlayerViewModel.CicleRepeatModeCommand}">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding PlayerViewModel.RepeatModeIcon}" FontSize="14"/>
                            </Button>
                            <Button 
                                Grid.Column="2" 
                                Style="{StaticResource PlayerButton}"  
                                ToolTip="Previous track" 
                                Command="{Binding PlayerViewModel.PreviousCommand}">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe892;" FontSize="14"/>
                            </Button>
                            <Button 
                                Grid.Column="3" 
                                Style="{StaticResource PlayerButton}"  
                                Command="{Binding PlayerViewModel.PlayPauseCommand}">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding PlayerViewModel.PlayPauseIcon, Mode=OneWay}" FontSize="20"/>
                            </Button>
                            <Button 
                                 Grid.Column="4"
                                 Style="{StaticResource PlayerButton}" 
                                 ToolTip="Next track" 
                                 Command="{Binding PlayerViewModel.NextCommand}">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xe893;" FontSize="14"/>
                            </Button>
                            <Button 
                                Grid.Column="5"
                                Style="{StaticResource PlayerButton}" 
                                ToolTip="{Binding PlayerViewModel.ShuffleTooltip}"
                                Command="{Binding PlayerViewModel.ToggleShuffleCommand}">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding PlayerViewModel.ShuffleIcon}" FontSize="14"/>
                            </Button>
                            <Grid Grid.Column="0">
                                <Button x:Name="VolumeButton" Click="VolumeButton_Click" Style="{StaticResource PlayerButton}" Padding="0" ToolTip="Volume" HorizontalAlignment="Left">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <Popup
                                x:Name="VolumePopup"
                                PlacementTarget="{Binding ElementName=VolumeButton}"
                                Placement="Center"
                                PopupAnimation="None"
                                AllowsTransparency="True"
                                StaysOpen="False">
                                <Border>
                                    <Border 
                                        Background="{Binding PlayerViewModel.CurrentTrackDominantColorHex}" 
                                        BorderBrush="{DynamicResource StrokeFloating}" 
                                        CornerRadius="8" 
                                        Margin="8,16"
                                        Padding="8,4"
                                        BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000"
                                                BlurRadius="16"
                                                ShadowDepth="4"
                                                Direction="270"
                                                Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <controls:VolumeControl
                                                Width="150"
                                                Height="32"/>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                    <controls:SpectrumVisualizerControl
                        x:Name="SpectrumVisualizer"
                        Opacity="0.5"
                        Height="100"
                        BarCount="128"
                        Visibility="{Binding IsVisualizerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Visualizer="{Binding PreferredVisualizer}"
                        SpectrumType="{Binding PreferredSpectrumType}"
                        />
                </StackPanel>
            </Grid>

            <Border 
                x:Name="PanelContainer"
                HorizontalAlignment="Right"
                ClipToBounds="True"
                >
            </Border>


            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                <controls:AppButton 
                    Style="{StaticResource PlayerButton}" 
                    Command="{Binding ExitFullScreenCommand}"
                    ToolTip="Exit fullscreen"
                    Icon="&#xE73F;"
                    IconFontSize="20"
                    Opacity="0.5"
                />
            </Grid>

        </Grid>
    </Grid>

</UserControl>
