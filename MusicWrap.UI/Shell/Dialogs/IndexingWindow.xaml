<Window x:Class="MusicWrap.UI.Shell.Dialogs.IndexingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicWrap.UI.Shell.Dialogs"
        xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
        xmlns:models="clr-namespace:MusicWrap.UI.Models"
        mc:Ignorable="d"
        Title="Indexer Manager"
        Height="550"
        Width="700"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Icon="/Resources/icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LEFT PANEL: Tracks List -->
        <Border Grid.Column="0" Grid.Row="0">
            <DockPanel>
                <TextBlock 
                    DockPanel.Dock="Top"
                    Text="Tracks to Index"
                    Padding="8"
                    FontSize="13"
                    FontWeight="SemiBold"
                        />
                <ListBox
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding StagedTracks}"
                    SelectedItem="{Binding SelectedTrack}"
                    SelectionMode="Extended"
                    SelectionChanged="StagedTracks_SelectionChanged"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Padding="2">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove selected tracks"
                                          Click="RemoveSelectedTracks_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:StagedTrackNode">
                            <Grid Margin="0" MinHeight="50">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove track"
                                                  Click="RemoveTrack_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <!-- Track Index -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Index}"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Margin="4,0"/>

                                <Border
                                    Grid.Column="1"
                                    Width="48"
                                    Height="48"
                                    VerticalAlignment="Top">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                </Border>


                                <!-- Track Info -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="4,0">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Text="{Binding Artist}"
                                        FontSize="11"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="0,2,0,0"/>

                                    <TextBlock
                                        Text="{Binding Album}"
                                        FontSize="10"
                                        Opacity="0.5"
                                        TextTrimming="CharacterEllipsis"
                                        Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3d3d3d"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT PANEL: Metadata Editor -->
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource BackgroundLayer}">
            <DockPanel>
                <TextBlock 
                    DockPanel.Dock="Top"
                    Text="Track Metadata"
                    Padding="12,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Background="{StaticResource BackgroundLayer}"/>
                <StackPanel Margin="12" Visibility="{Binding HasTrackSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Title" Opacity="0.75" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <controls:AppInput
                        Height="30"
                        Text="{Binding SelectedTitleValue, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="12"/>

                    <TextBlock Text="Artist" Opacity="0.75" FontSize="11" Margin="0,6,0,4" FontWeight="SemiBold"/>
                    <controls:AutocompleteMetadataInput
                        Text="{Binding SelectedArtistValue, UpdateSourceTrigger=PropertyChanged}"
                        MetadataType="ArtistName"/>

                    <TextBlock Text="Album" Opacity="0.75" FontSize="11" Margin="0,6,0,4" FontWeight="SemiBold"/>
                    <controls:AutocompleteMetadataInput
                        Text="{Binding SelectedAlbumValue, UpdateSourceTrigger=PropertyChanged}"
                        MetadataType="AlbumTitle"/>

                    <TextBlock Text="Genre" Opacity="0.75" FontSize="11" Margin="0,6,0,4" FontWeight="SemiBold"/>
                    <controls:AutocompleteMetadataInput
                        Text="{Binding SelectedGenreValue, UpdateSourceTrigger=PropertyChanged}"
                        MetadataType="GenreName"/>

                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Track Number" Opacity="0.75" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <controls:AppInput
                                Height="30"
                                Text="{Binding SelectedTrackNumberValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Disc Number" Opacity="0.75" FontSize="11" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <controls:AppInput
                                Height="30"
                                Text="{Binding SelectedDiscNumberValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Year" Opacity="0.75" FontSize="11" Margin="0,6,0,4" FontWeight="SemiBold"/>
                    <controls:AppInput
                        Height="30"
                        Text="{Binding SelectedYearValue, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Duration" Opacity="0.75" FontSize="11" Margin="0,6,0,4" FontWeight="SemiBold"/>
                    <TextBlock
                        Height="30"
                        Text="{Binding SelectedDurationValue, Mode=OneWay}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.ColumnSpan="2" Grid.Row="1" Background="{StaticResource BackgroundLayer}" Padding="0">
            <ProgressBar
                Height="6"
                Minimum="0"
                Maximum="{Binding IndexingProgressMaximum}"
                Value="{Binding IndexingProgressValue}"
                Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsIndeterminate="True"
                Foreground="{StaticResource AccentBrush80}"
                Background="#111111"
                Focusable="False"
                />
        </Border>

        <Border Grid.ColumnSpan="2" Grid.Row="2" Background="{StaticResource BackgroundLayer}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="{Binding SaveStatusMessage}"
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    TextTrimming="CharacterEllipsis"
                    FontSize="11"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="8,0"
                            Style="{StaticResource DefaultButton}"
                            Command="{Binding ClearAllStagedTracksCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear entries" Margin="4,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding SaveAllStagedTracksCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;" VerticalAlignment="Center"/>
                            <TextBlock Text="Save all entries" Margin="4,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



