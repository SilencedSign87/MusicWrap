<Window x:Class="MusicWrap.UI.Shell.Dialogs.InformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MusicWrap.UI.Features.Metadata.Views"
        xmlns:vm="clr-namespace:MusicWrap.UI.ViewModels"
        xmlns:nav="clr-namespace:MusicWrap.UI.Shared.Controls.Navigation"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Icon="/Resources/icon.ico"
        d:Background="#080808"
        d:Foreground="White"
        d:DataContext="{d:DesignInstance Type=vm:InformationWindowViewModel}"
        Title="{Binding DisplayTitle}" Height="650" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <nav:ShellTabControl Grid.Row="0"
                             SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <nav:ShellTabItem Icon="&#xEDA2;" IconSize="20" Spacing="8" Text="General" Orientation="Vertical">
                <views:MetadataGeneralView DataContext="{Binding General}"/>
            </nav:ShellTabItem>
            <nav:ShellTabItem Icon="&#xE8EC;" IconSize="20" Spacing="8" Text="Tags" Orientation="Vertical">
                <views:MetadataEditorView DataContext="{Binding Fields }"/>
            </nav:ShellTabItem>
            <nav:ShellTabItem Icon="&#xE8B9;" IconSize="20" Spacing="8" Text="Artworks" Orientation="Vertical">
                <views:MetadataArtworkEditorView DataContext="{Binding Artwork}"/>
            </nav:ShellTabItem>
            <nav:ShellTabItem Icon="&#xEC4F;" IconSize="20" Spacing="8" Text="Lyrics" Orientation="Vertical">
                <views:MetadataLyricsEditorView DataContext="{Binding Lyrics}"/>
            </nav:ShellTabItem>
        </nav:ShellTabControl>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="8" Orientation="Horizontal">
            <Button Margin="8,0" Style="{StaticResource AccentButton}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding SelectedTabHasChanges}">
                Save
            </Button>
            <Button Style="{StaticResource DefaultButton}"
                    Command="{Binding CancelChangesCommand}"
                    IsEnabled="{Binding SelectedTabHasChanges}">
                Cancel changes
            </Button>
        </StackPanel>
    </Grid>
</Window>
