<Window x:Class="MusicWrap.UI.Shell.Dialogs.PlaylistManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicWrap.UI.Shell.Dialogs"
        xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        d:Background="#202020"
        d:Foreground="White"
        Title="New Playlist" 
        Height="350" 
        Width="250"
        d:WindowStyle="None"
        >
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="36,28,36,0">
            <StackPanel>
                <TextBlock x:Name="TitleBox" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/>

                <controls:SquarePanel >
                    <Border 
                        Background="{DynamicResource BackgroundLayer}" 
                        CornerRadius="4"
                        >

                    </Border>
                </controls:SquarePanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="36,0,36,12" VerticalAlignment="Center">
            <controls:AppInput
                x:Name="PlaylistNameInput"
                Height="32"
                PlaceholderText="Playlist name..."
                PreviewKeyDown="PlaylistNameInput_KeyDown"
                />
        </StackPanel>
        <StackPanel Grid.Row="2" >
            <Separator VerticalAlignment="Bottom"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8">
                <Button Content="Save" Style="{StaticResource AccentButton}" Margin="8,0" Click="SavePlaylist_Click"/>
                <Button Content="Cancel" Style="{StaticResource DefaultButton}" Click="CancelPlaylist_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>


