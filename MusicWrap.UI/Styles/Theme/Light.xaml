<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Background -->
    <SolidColorBrush x:Key="BackgroundSolid" Color="#F3F3F3" />
    <SolidColorBrush x:Key="BackgroundSolidAlt" Color="#DADADA" />
    <SolidColorBrush x:Key="BackgroundSolid2" Color="#EEEEEE" />
    <SolidColorBrush x:Key="BackgroundSolid3" Color="#F9F9F9" />
    <SolidColorBrush x:Key="BackgroundSolid4" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundSolid5" Color="#FDFDFD" />
    <SolidColorBrush x:Key="BackgroundSolid6" Color="#FFFFFF" />
    <!-- Layer -->
    <SolidColorBrush x:Key="BackgroundLayer" Color="#ffffff" Opacity="0.5"/>
    <SolidColorBrush x:Key="BackgroundLayerAlt" Color="#ffffff" Opacity="1" />
    <!-- Card -->
    <SolidColorBrush x:Key="BackgroundCard1" Color="#ffffff" Opacity="0.7"/>
    <!-- Default -->
    <SolidColorBrush x:Key="BackgroundCard2" Color="#f6f6f6" Opacity="0.5"/>
    <!-- Hover -->
    <SolidColorBrush x:Key="BackgroundCard3" Color="#ffffff" Opacity="1" />
    <!-- Pressed -->
    <SolidColorBrush x:Key="BackgroundSmoke" Color="#000000" Opacity="0.3" />
    <!-- Control -->
    <SolidColorBrush x:Key="BackgroundControlTransparent" Color="#ffffff" Opacity="0"/>
    <SolidColorBrush x:Key="BackgroundControlDefault" Color="#ffffff" Opacity="0.7"/>
    <SolidColorBrush x:Key="BackgroundControlHover" Color="#f9f9f9" Opacity="0.5" />
    <SolidColorBrush x:Key="BackgroundControlPressed" Color="#f9f9f9" Opacity="0.3" />
    <SolidColorBrush x:Key="BackgroundControlDisable" Color="#f3f3f3" Opacity="0.76" />

    <!-- Floating -->
    <SolidColorBrush x:Key="BackgroundFloating" Color="#FFFFFF" />
    <!-- Stroke -->
    <SolidColorBrush x:Key="StrokeSurface" Color="#000000" Opacity="0.12"/>
    <SolidColorBrush x:Key="StrokeLayerCard" Color="#000000" Opacity="0.06"/>
    <SolidColorBrush x:Key="StrokeFloating" Color="#000000" Opacity="0.10"/>
    <SolidColorBrush x:Key="StrokeControl" Color="#000000" Opacity="0.08"/>
    <SolidColorBrush x:Key="StrokeDivider" Color="#000000" Opacity="0.10"/>
    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF666666"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF999999"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush10" Color="#000307" />
    <SolidColorBrush x:Key="AccentBrush20" Color="#001929" />
    <SolidColorBrush x:Key="AccentBrush30" Color="#002840" />
    <SolidColorBrush x:Key="AccentBrush40" Color="#003454" />
    <SolidColorBrush x:Key="AccentBrush50" Color="#004169" />
    <SolidColorBrush x:Key="AccentBrush60" Color="#004D80" />
    <SolidColorBrush x:Key="AccentBrush70" Color="#005A99" />
    <SolidColorBrush x:Key="AccentBrush80" Color="#0067B4" />
    <SolidColorBrush x:Key="AccentBrush90" Color="#0074D1" />
    <SolidColorBrush x:Key="AccentBrush100" Color="#3881E1" />
    <SolidColorBrush x:Key="AccentBrush110" Color="#588DEE" />
    <SolidColorBrush x:Key="AccentBrush120" Color="#759AF9" />
    <SolidColorBrush x:Key="AccentBrush130" Color="#90A7FF" />
    <SolidColorBrush x:Key="AccentBrush140" Color="#ABB5FF" />
    <SolidColorBrush x:Key="AccentBrush150" Color="#C2C4FF" />
    <SolidColorBrush x:Key="AccentBrush160" Color="#D6D3FF" />

    <!-- Text on accent  -->
    <SolidColorBrush x:Key="TextOnAccentPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentSecondaryBrush" Color="#121212"/>
    <SolidColorBrush x:Key="TextOnAccentTertiaryBrush" Color="#202020"/>
    <Style x:Key="VerticalSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeDivider}"/>
        <Setter Property="Margin" Value="2,4"/>
    </Style>
    
</ResourceDictionary>