<UserControl x:Class="MusicWrap.UI.Features.Providers.Views.YoutubeProviderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Providers.Views"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Providers.ViewModels"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:YoutubeProviderViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="RootUserControl"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Padding="0" Width="32" Height="32" ToolTip="Go back" Click="BackButton_Click">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons"/>
                </Button>

                <ComboBox Grid.Column="1"
                          Margin="12,0"
                          MinWidth="140"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableSearchKinds}"
                          SelectedItem="{Binding SelectedKind}"
                          >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MaxWidth="400" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0">
                <ListView ItemsSource="{Binding SearchResults}"
                         SelectionChanged="SearchResults_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         >
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:YoutubeSearchLeafNode}">
                            <Grid ToolTip="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Background="#22000000">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Grid.Column="2" Background="{DynamicResource BackgroundLayer}">
                <Grid>
                    <TextBlock Text="{Binding EmptyStateText}" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Details.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:YoutubeDetailGroupNode}">
                                    <Border Padding="10" Margin="0,0,0,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource StrokeSurface}">
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <Image
                                                    Width="200"
                                                    Source="{Binding ThumbnailUrl}"
                                                    RenderOptions.BitmapScalingMode="LowQuality"
                                                    Margin="0,0,0,8"
                                                    />

                                                <TextBlock FontSize="11">
                                                    <Run Text="{Binding SubtitleTypePart, Mode=OneWay}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding SubtitleYearPart, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    Text="{Binding TracksInfoText}"
                                                    Visibility="{Binding TracksInfoText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                                                    />

                                            </StackPanel>
                                            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                                                <Border Grid.Row="0" Padding="0,0,0,8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                                                            <TextBlock FontSize="13" Text="{Binding ArtistName}" Margin="0,4" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <controls:AppButton
                                                                Icon="&#xEB51;"
                                                                ToolTip="Save"
                                                                Style="{StaticResource TransparentButton}"
                                                                />
                                                            <controls:AppButton 
                                                                Width="40"
                                                                Height="40"
                                                                Click="ShowTracks_Click"
                                                                >
                                                                <controls:AppButton.Style>
                                                                    <Style TargetType="controls:AppButton" BasedOn="{StaticResource TransparentButton}">
                                                                        <Setter Property="ToolTip" Value="Show Tracks"/>
                                                                        <Setter Property="Icon" Value="&#xE70D;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Icon" Value="&#xE70E;"/>
                                                                                <Setter Property="ToolTip" Value="Hide Tracks"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:AppButton.Style>
                                                            </controls:AppButton>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ItemsControl Grid.Row="1"
                                                         ItemsSource="{Binding Tracks}"
                                                         PreviewMouseWheel="TrackListBox_PreviewMouseWheel"
                                                         HorizontalContentAlignment="Stretch"
                                                         BorderThickness="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                         ScrollViewer.CanContentScroll="False"
                                                         Background="Transparent">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="Foreground" Value="{Binding Foreground ,ElementName=RootUserControl}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:YoutubeDetailTrackNode}">
                                                            <Border
                                                                BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource StrokeDivider}"
                                                                Padding="2"
                                                                >
                                                                <Grid
                                                                  ClipToBounds="True" 
                                                                  HorizontalAlignment="Stretch"
                                                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  >
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="26" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                           Text="{Binding Index}"
                                                                           FontSize="13"
                                                                           Opacity="0.65"
                                                                           VerticalAlignment="Center" />

                                                                    <TextBlock Grid.Column="1"
                                                                           Text="{Binding TitleWithSubtitle}"
                                                                           FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"
                                                                           VerticalAlignment="Center" />


                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                                        <TextBlock 
                                                                        Text="{Binding Duration}"
                                                                        FontSize="13"
                                                                        Opacity="0.75"
                                                                        Margin="8,0"
                                                                        TextAlignment="Right"
                                                                        VerticalAlignment="Center" />
                                                                        <controls:AppButton
                                                                        Style="{DynamicResource TransparentButton}"
                                                                        Icon="&#xEB51;"
                                                                        ToolTip="Save in library"
                                                                        />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <ProgressBar
            Height="4"
            BorderThickness="0"
            Foreground="{StaticResource AccentBrush80}"
            Background="#111111"
            Focusable="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsIndeterminate="True">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
    </Grid>
</UserControl>


