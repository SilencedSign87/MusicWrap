<UserControl x:Class="MusicWrap.UI.Features.Metadata.Views.MetadataLyricsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             mc:Ignorable="d"
             d:Foreground="White"
             d:DesignHeight="650" d:DesignWidth="500"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             >
    <Grid x:Name="LyricsGridRoot" RowDefinitions="Auto,*" >
        <Border x:Name="Toolbar" Grid.Row="0" Background="{DynamicResource BackgroundFloating}" BorderThickness="1" BorderBrush="{DynamicResource BackgroundFloating}" Margin="8,0,8,8" CornerRadius="2" >
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.5"/>
            </Border.Effect>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="42,8">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <controls:AppButton Grid.Column="0" Style="{StaticResource SubtleButton}" ToolTip="Save" Icon="&#xE74E;" />
                    <controls:AppButton Grid.Column="0" Style="{StaticResource SubtleButton}" ToolTip="Import" Icon="&#xE8B5;" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                    <controls:AppButton Grid.Column="0" Style="{StaticResource SubtleButton}" ToolTip="Add paragraph" Icon="&#xE751;" />
                    <controls:AppButton Grid.Column="0" Style="{StaticResource SubtleButton}" ToolTip="Remove paragraph" Icon="&#xE750;" />
                    <Border Style="{DynamicResource VerticalSeparator}" Width="2" Margin="4" />
                    <controls:AppButton Grid.Column="0" Style="{StaticResource SubtleButton}" ToolTip="Rewind" Icon="&#xEB9E;" />
                    <controls:AppButton Grid.Column="4" Style="{StaticResource SubtleButton}" ToolTip="Add timestamp" Icon="&#xECC8;" />
                    <controls:AppButton Grid.Column="4" Style="{StaticResource SubtleButton}" ToolTip="Remove timestamp" Icon="&#xECC9;" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <controls:WaveformPlayerControl 
                        UsePlaceholderWaveform="True"
                        />
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <TextBox
                Grid.Row="1"
                Margin="4"
                Style="{DynamicResource TransparentTextInput}"
                BorderBrush="{DynamicResource StrokeSurface}"
                BorderThickness="1"
                AcceptsReturn="True"
                AcceptsTab="True"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                FontSize="12"
                Padding="4"
                />
        </Grid>
    </Grid>
</UserControl>
