<UserControl x:Class="MusicWrap.UI.Features.Metadata.Views.MetadataLyricsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:vm ="clr-namespace:MusicWrap.UI.Features.Metadata.Viewmodels"
             xmlns:models="clr-namespace:MusicWrap.Data.Library.Models;assembly=MusicWrap.Data"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             mc:Ignorable="d"
             d:Foreground="White"
             d:DesignHeight="650" d:DesignWidth="500"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DataContext="{d:DesignInstance Type=vm:MetadataLyricsEditorViewmodel}"
             >
    <UserControl.Resources>
        <DataTemplate x:Key="LyricsCardTemplate" DataType="{x:Type models:Lyrics}">
            <Border 
                Margin="8,2"
                CornerRadius="4"
                Padding="4"
                Background="{DynamicResource BackgroundCard1}" 
                BorderBrush="{DynamicResource StrokeLayerCard}" 
                BorderThickness="1">
                <Grid ColumnDefinitions="*,12,Auto">
                    <TextBlock Text="{Binding Language}" Grid.Column="0" />
                    <TextBlock Text="&#xE76C;" Grid.Column="2" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer 
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="8"
        >
        <StackPanel>
            <controls:SectionTitleSeparator Title="Original" Margin="0,0,0,5" />
            <ContentPresenter 
                Content="{Binding DefaultLyrics}" 
                ContentTemplate="{StaticResource LyricsCardTemplate}" 
                Visibility="{Binding DefaultLyrics, Converter={StaticResource NullToCollapseConverter}}"
                />
            <controls:SectionTitleSeparator Title="Translations" />
            <ItemsControl ItemsSource="{Binding LyricsVariants}" ItemTemplate="{StaticResource LyricsCardTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
