<UserControl x:Class="MusicWrap.UI.Features.Metadata.Views.MetadataArtworkEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Metadata.Viewmodels"
             xmlns:art="clr-namespace:MusicWrap.Core.Services.Library;assembly=MusicWrap.Core"
             mc:Ignorable="d"
             x:Name="ArtworkEditorRoot"
             d:DataContext="{d:DesignInstance Type=vm:MetadataArtworkEditorViewmodel}"
             d:DesignHeight="600" d:DesignWidth="500"
             d:Foreground="white"
             d:Background="Black"
             >
    <UserControl.Resources>

        <!-- Artwork Render Template -->
        <DataTemplate x:Key="ArtworkRenderTemplate" DataType="vm:ArtworkEntry">
            <controls:SquarePanel VerticalAlignment="Top">
                <Grid>
                    <!-- 1 Artwork -->
                    <controls:ImageContainer
                        Source="{Binding CurrentArtworkPath, Converter={StaticResource PathToImageConverter}, ConverterParameter=150}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource StrokeSurface}"
                        CornerRadius="4">
                        <controls:ImageContainer.Style>
                            <Style TargetType="controls:ImageContainer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMultipleValues}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentArtworkPath}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:ImageContainer.Style>
                    </controls:ImageContainer>

                    <!-- Multiple artworks -->
                    <Border
                        Background="{DynamicResource BackgroundCard1}"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource StrokeSurface}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMultipleValues}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Multiple Values"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Opacity="0.5"/>
                    </Border>

                    <!-- fallback -->
                    <Border
                        BorderThickness="1"
                        BorderBrush="{DynamicResource StrokeSurface}"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasMultipleValues}" Value="False"/>
                                            <Condition Binding="{Binding CurrentArtworkPath}" Value=""/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No Artwork"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Opacity="0.5"/>
                    </Border>
                </Grid>
            </controls:SquarePanel>
        </DataTemplate>

        <!-- ArtworkEntry Template -->
        <DataTemplate x:Key="ArtworkEntryTemplate" DataType="vm:ArtworkEntry">
            <Grid Margin="8" RowDefinitions="Auto,Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Artwork -->
                <ContentPresenter
                    Grid.Column="0"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource ArtworkRenderTemplate}"
                    />

                <StackPanel Grid.Column="2">
                    <CheckBox
                        Content="Edit Artwork"
                        IsChecked="{Binding EditEnabled, Mode=TwoWay}"
                        Margin="0,0,0,8"
                        />
                    <Grid 
                        ColumnDefinitions="Auto,4,*"
                        Visibility="{Binding EditEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                        >
                        <ComboBox 
                            Grid.Column="0" 
                            SelectedItem="{Binding SelectionMode}"
                            ItemsSource="{Binding SelectionModes}"
                            VerticalAlignment="Top"
                            >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- SelectFile -->
                        <Border Grid.Column="3">
                            <StackPanel>

                                <Grid ColumnDefinitions="*,8,Auto,Auto" Height="36">
                                    <controls:AppButton 
                                    Grid.Column="2"
                                    Grid.Row="0"
                                    Style="{StaticResource DefaultButton}"
                                    Icon="&#xE838;"
                                    Text="Select File..."
                                    Command="{Binding SelectFileCommand}"
                                    />
                                    <controls:AppButton
                                    Grid.Column="3"
                                    Grid.Row="0"
                                    Style="{StaticResource DefaultButton}"
                                    Icon="&#xE711;"
                                    Text="Cancel"
                                    Command="{Binding ClearSelectionCommand}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="4,0,0,0"
                                    />


                                </Grid>
                                <TextBlock 
                                    Margin="0,8,0,0"
                                    Text="{Binding CurrentArtworkPath}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding HasChanged, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    />
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectionMode}" Value="{x:Static vm:ArtworkSelectionMode.SelectFile}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- ExistingFile -->
                        <Grid Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasChanged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:AppButton
                                    Style="{StaticResource DefaultButton}"
                                    Icon="&#xE711;"
                                    Text="Remove selection"
                                    Command="{Binding ClearSelectionCommand}"
                                />
                            </StackPanel>

                            <StackPanel 
                                Visibility="{Binding HasChanged, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"
                                        >
                                <controls:AppInput 
                                Height="32"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search track or album artwork..."
                                />

                                <ListView
                                Margin="0,4,0,0"
                                MaxHeight="240"
                                ItemsSource="{Binding Suggestions}"
                                SelectedItem="{Binding PickedArtwork, Mode=TwoWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding HasSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="art:ArtworkOption">
                                            <Grid Height="48" Margin="4" ColumnDefinitions="48,*" ToolTip="{Binding DisplayName}">
                                                <controls:ImageContainer
                                                Grid.Column="0"
                                                Width="48" Height="48"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource StrokeSurface}"
                                                CornerRadius="4"
                                                Source="{Binding FilePath,
                                                                Converter={StaticResource PathToImageConverter},
                                                                ConverterParameter=48}" />
                                                <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectionMode}" Value="{x:Static vm:ArtworkSelectionMode.ExistingFile}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </Grid>

                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>
    <Grid RowDefinitions="*,48">

        <StackPanel Grid.Row="0" Margin="8,8,8,0">
            <controls:SectionTitleSeparator Title="{Binding AlbumSectionTitle}"/>
            <ContentPresenter
            Content="{Binding AlbumArtworkSource}"
            ContentTemplate="{StaticResource ArtworkEntryTemplate}"
            />

            <controls:SectionTitleSeparator Title="{Binding TrackSectionTitle}" Margin="0,16,0,0" />
            <ContentPresenter
            Content="{Binding TrackArtworkSource}"
            ContentTemplate="{StaticResource ArtworkEntryTemplate}"
            />
        </StackPanel>
        <Border 
            Grid.Row="1"
            Padding="8"
            Background="{DynamicResource BackgroundLayer}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource StrokeSurface}"
            >
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Grid.Column="0">

                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <controls:AppButton 
                        Style="{StaticResource AccentButton}"
                        Icon="&#xE74E;"
                        Text="Save"
                        Command="{Binding SaveChangesCommand}"
                       />
                    <controls:AppButton
                        Style="{StaticResource DefaultButton}"
                        Margin="8,0,0,0"
                        Text="Cancel"
                        Command="{Binding CancelChangesCommand}"
                        />
                </StackPanel>
            </Grid>

        </Border>
    </Grid>
</UserControl>
