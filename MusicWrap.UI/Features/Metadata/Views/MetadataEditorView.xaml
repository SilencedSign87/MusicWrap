<UserControl x:Class="MusicWrap.UI.Features.Metadata.Views.MetadataEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Metadata.Viewmodels"
             mc:Ignorable="d"
             d:Foreground="white"
             d:Background="Black"
             d:DesignHeight="600" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=vm:MetadataEditorViewmodel}"
             >

    <UserControl.Resources>
        <SolidColorBrush x:Key="TagChangedForeground" Color="#6CCB5F"/>

        <Style x:Key="TagInputStyle"
               TargetType="controls:AppInput"
               BasedOn="{StaticResource {x:Type controls:AppInput}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TagChangedForeground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TagAutocompleteInputStyle" TargetType="controls:AutocompleteMetadataInput">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TagChangedForeground}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasChanges}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,48">
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     Height="4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <ScrollViewer Grid.Row="1" Margin="16,4,16,0" Background="{DynamicResource BackgroundLayer}">
            <Grid VerticalAlignment="Top" RowDefinitions="*,8,*,8,*,8,*,8,*,8,*,8,*,8,*,8,*,8,*" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="TitleGroup"/>
                    <ColumnDefinition Width="8" SharedSizeGroup="GapGroup"/>
                    <ColumnDefinition Width="*" SharedSizeGroup="ValueGroup"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Title" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:AppInput Grid.Column="2" Grid.Row="0"  
                                   Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="{Binding TitlePlaceholder}"
                                   />

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Artists" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:TokenizingTextBox Grid.Column="2" Grid.Row="2" 
                                            ItemsSource="{Binding Artists}" 
                                            AutocompleteSource="{Binding ArtistSuggestions}"
                                            PlaceholderText="{Binding ArtistsPlaceholder}" 
                                            />

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Album" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:AppInput Grid.Column="2" Grid.Row="4" 
                                   Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" 
                                   PlaceholderText="{Binding AlbumPlaceholder}"
                                   />

                <TextBlock Grid.Column="0" Grid.Row="6" Text="Album Artists" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:TokenizingTextBox Grid.Column="2" Grid.Row="6"
                                            ItemsSource="{Binding AlbumArtists}"
                                            AutocompleteSource="{Binding AlbumArtistSuggestions}"
                                            PlaceholderText="{Binding AlbumArtistsPlaceholder}"
                                            />

                <TextBlock Grid.Column="0" Grid.Row="8" Text="Genres" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:TokenizingTextBox Grid.Column="2" Grid.Row="8"
                                            ItemsSource="{Binding Genres}"
                                            AutocompleteSource="{Binding GenreSuggestions}"
                                            PlaceholderText="{Binding GenresPlaceholder}"
                                            />

                <TextBlock Grid.Column="0" Grid.Row="10" Text="Year" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:AppInput Grid.Column="2" Grid.Row="10" Width="200" HorizontalAlignment="Left" 
                                   Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="{Binding YearPlaceholder}"
                                   />

                <TextBlock Grid.Column="0" Grid.Row="12" Text="Track" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <Grid Grid.Column="2" Grid.Row="12" Width="200" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:AppInput Grid.Column="0" Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}" 
                                       PlaceholderText="{Binding TrackNumberPlaceholder}"/>
                    <TextBlock Grid.Column="1" Text="of" Margin="8,0" VerticalAlignment="Center"/>
                    <controls:AppInput Grid.Column="2" Text="{Binding TrackCount, UpdateSourceTrigger=PropertyChanged}" 
                                       PlaceholderText="{Binding TrackCountPlaceholder}"/>
                </Grid>

                <TextBlock Grid.Column="0" Grid.Row="14" Text="Disk" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <Grid Grid.Column="2" Grid.Row="14" Width="200" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <controls:AppInput Grid.Column="0" Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}" 
                                       PlaceholderText="{Binding DiscNumberPlaceholder}"/>
                    <TextBlock Grid.Column="1" Text="of" Margin="8,0" VerticalAlignment="Center"/>
                    <controls:AppInput Grid.Column="2" Text="{Binding DiscCount, UpdateSourceTrigger=PropertyChanged}" 
                                       PlaceholderText="{Binding DiscCountPlaceholder}"/>
                </Grid>

                <TextBlock Grid.Column="0" Grid.Row="16" Text="Rating" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <controls:AppInput Grid.Row="16" Grid.Column="2"
                                   Width="200" HorizontalAlignment="Left"
                                   Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                                   PlaceholderText="{Binding RatingPlaceholder}"
                                   />


                <TextBlock Grid.Column="0" Grid.Row="18" Text="Play count" Margin="0,8,0,8" VerticalAlignment="Center" TextAlignment="Right"/>
                <Grid Grid.Column="2" Grid.Row="18" ColumnDefinitions="*,8,Auto" Width="200" HorizontalAlignment="Left">
                    <controls:AppInput Grid.Column="0"
                                       Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                                       PlaceholderText="{Binding RatingPlaceholder}"    
                                       />
                    <controls:AppButton Grid.Column="2" Style="{StaticResource DefaultButton}" Text="Reset" />
                </Grid>
            </Grid>
        </ScrollViewer>
        <!-- Header -->
        <Border 
            Grid.Row="2"
            Padding="8"
            Background="{DynamicResource BackgroundLayer}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource StrokeSurface}"
            >
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Grid.Column="0">

                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <controls:AppButton 
                 Style="{StaticResource AccentButton}"
                 Icon="&#xE74E;"
                 Text="Save"
                        Command="{Binding SaveChangesCommand}"
                />
                    <controls:AppButton
                 Style="{StaticResource DefaultButton}"
                 Margin="8,0,0,0"
                 Text="Cancel"
                        Command="{Binding CancelChangesCommand}"
                 />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
