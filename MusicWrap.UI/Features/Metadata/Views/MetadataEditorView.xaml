<UserControl x:Class="MusicWrap.UI.Features.Metadata.Views.MetadataEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d"
             d:Foreground="white"
             d:Background="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="{DynamicResource BackgroundLayer}">
        <Grid Margin="8" Grid.IsSharedSizeScope="True">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Title:" VerticalAlignment="Center" FontSize="12"/>
                    <controls:AppInput Grid.Column="2"
                                       Height="32"
                                       Text="{Binding Title.Value, Mode=TwoWay}"
                                       PlaceholderText="{Binding Title.Placeholder, Mode=OneWay}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Artist:" VerticalAlignment="Center" FontSize="12"/>
                    <controls:AutocompleteMetadataInput
                        Grid.Column="2"
                        Height="32"
                        Text="{Binding Artist.Value, Mode=TwoWay}"
                        MetadataType="ArtistName"
                        PlaceholderText="{Binding Artist.Placeholder, Mode=OneWay}"
                        IsMultipleValueEnabled="True"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Album:" VerticalAlignment="Center" FontSize="12"/>
                    <controls:AppInput Grid.Column="2"
                                       Height="32"
                                       Text="{Binding Album.Value, Mode=TwoWay}"
                                       PlaceholderText="{Binding Album.Placeholder, Mode=OneWay}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Album artist:" VerticalAlignment="Center" FontSize="12"/>
                    <controls:AutocompleteMetadataInput
                        Grid.Column="2"
                        Height="32"
                        Text="{Binding AlbumArtist.Value, Mode=TwoWay}"
                        PlaceholderText="{Binding AlbumArtist.Placeholder, Mode=OneWay}"
                        MetadataType="ArtistName"
                        IsMultipleValueEnabled="True"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Genre:" VerticalAlignment="Center" FontSize="12"/>
                    <controls:AutocompleteMetadataInput
                        Grid.Column="2"
                        Height="32"
                        Text="{Binding Genre.Value, Mode=TwoWay}"
                        PlaceholderText="{Binding Genre.Placeholder, Mode=OneWay}"
                        MetadataType="GenreName"
                        IsMultipleValueEnabled="True"/>
                </Grid>
                <Separator Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Year:" VerticalAlignment="Top" FontSize="12" Margin="0,4,0,0"/>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppInput Grid.Column="0"
                                           Height="32"
                                           Width="150"
                                           VerticalAlignment="Top"
                                           Text="{Binding Year.Value, Mode=TwoWay}"
                                           PlaceholderText="{Binding Year.Placeholder, Mode=OneWay}"/>
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="subgridlabel"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Track:" VerticalAlignment="Center" FontSize="12"/>
                                <controls:AppInput Grid.Column="2"
                                                   Height="32"
                                                   Text="{Binding TrackNumber.Value, Mode=TwoWay}"
                                                   PlaceholderText="{Binding TrackNumber.Placeholder, Mode=OneWay}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="subgridlabel"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Disk:" VerticalAlignment="Center" FontSize="12"/>
                                <controls:AppInput Grid.Column="2"
                                                   Height="32"
                                                   Text="{Binding DiskNumber.Value, Mode=TwoWay}"
                                                   PlaceholderText="{Binding DiskNumber.Placeholder, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
