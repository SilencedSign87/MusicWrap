<UserControl x:Class="MusicWrap.UI.Features.Metadata.Views.MetadataGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Metadata.Viewmodels"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d"
             d:Foreground="White"
             d:DataContext="{d:DesignInstance Type=vm:MetadataGeneralViewmodel}"
             d:DesignHeight="800" d:DesignWidth="500">
    <UserControl.Resources>
        <Style x:Key="MultipleValueTextStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static vm:MetadataGeneralViewmodel.MultipleValuesString}">
                    <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,48">
        <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="4" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <StackPanel  Grid.Row="1" Margin="16,4,16,0">
            <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" MinWidth="150" Opacity="0.6" VerticalAlignment="Top" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource MultipleValueTextStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Border 
            Grid.Row="2" 
            Padding="8" 
            Background="{DynamicResource BackgroundLayer}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource StrokeSurface}"
            >
            <controls:AppButton 
                Style="{DynamicResource DefaultButton}" 
                HorizontalAlignment="Right" 
                Command="{Binding ShowInExplorerCommand}" 
                Icon="&#xEC50;" 
                Spacing="8"
                Text="Open in explorer"/>
        </Border>

    </Grid>
</UserControl>
