<UserControl x:Class="MusicWrap.UI.Features.Playlist.Views.PlaylistPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Playlist.Views"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:controlsM="clr-namespace:MusicWrap.UI.Controls.Models"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Playlist.ViewModels"
             mc:Ignorable="d" 
             x:Name="RootControl"
             Foreground="{DynamicResource TextPrimaryBrush}"
             d:DataContext="{d:DesignInstance Type=vm:PlaylistViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="PlaylistCompactGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="ColumnHeaderHeight" Value="24"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>

        <Style x:Key="PlaylistCompactRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BackgroundControlHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush100}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaylistCompactCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PlaylistCompactHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeDivider}"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,8,0,0">
                <controls:AppMenu>
                    <controls:AppMenuItem
                    Icon="{ex:Icon Glyph=EA37}"
                    Header="Playlists"
                    >
                        <controls:AppMenuItem Header="New playlist" Icon="{ex:Icon Glyph=E710}" Command="{Binding NewPlaylistCommand}" />
                        <controls:AppMenuItem Header="Refresh" Icon="{ex:Icon Glyph=E72C}" Command="{Binding RefreshCommand}" />
                        <Separator/>
                        <controls:AppMenuItem Header="Import" Icon="{ex:Icon Glyph=EA52}" />
                        <controls:AppMenuItem Header="Export" Icon="{ex:Icon Glyph=EDE1}" />
                    </controls:AppMenuItem>
                    <controls:AppMenuItem
                    Icon="{ex:Icon Glyph=E7B3}"
                    Header="View"
                    >
                        <controls:AppMenuItem Header="Title" IsCheckable="True" />
                        <controls:AppMenuItem Header="Track count" IsCheckable="True" />
                        <controls:AppMenuItem Header="Last updated" IsCheckable="True" />
                        <Separator />
                        <controls:AppMenuItem Header="Ascending" IsCheckable="True" Icon="{ex:Icon Glyph=E74A, FontSize=12}" />

                        <controls:AppMenuItem Header="Descending" IsCheckable="True" Icon="{ex:Icon Glyph=E74B, FontSize=12}" />
                        <Separator />
                        <controls:AppMenuItem Header="Artwork" IsCheckable="True" IsChecked="{Binding CompactMode, Mode=TwoWay}" Icon="{ex:Icon Glyph=E91B}" />
                        <controls:AppMenuItem Header="Compact" IsCheckable="True" IsChecked="{Binding CompactMode, Converter={StaticResource InverseBoolConverter}}" Icon="{ex:Icon Glyph=E8FD}" />
                    </controls:AppMenuItem>
                </controls:AppMenu>
            </StackPanel>

            <ListView
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                Grid.Row="1"
                SelectionMode="Single"
                HorizontalAlignment="Stretch"
                >
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Icon="{ex:Icon Glyph=E768}" Header="Play" Click="PlayPlaylist_Click"/>
                        <MenuItem Icon="{ex:Icon Glyph=E893}" Header="Play next"  Click="PlayNext_Click"/>
                        <MenuItem Icon="{ex:Icon Glyph=E710}" Header="Add to queue" />
                        <Separator/>
                        <MenuItem Icon="{ex:Icon Glyph=E70F}" Header="Rename" />
                        <MenuItem Icon="{ex:Icon Glyph=E74D}" Header="Delete" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Height" Value="auto"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="vm:PlaylistEntry">
                        <Grid 
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            >
                            <!-- Compact -->
                            <StackPanel x:Name="CompactLayout"
                            Orientation="Horizontal"
                            Margin="0"
                            ToolTipService.ToolTip="{Binding Title}"
                            HorizontalAlignment="Stretch">
                                <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=42}"
                           Width="42"
                           Height="42"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="LowQuality" />
                                <StackPanel Orientation="Vertical" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <!-- List -->
                            <StackPanel
                                x:Name="ListLayout"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                >
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE90B;" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    Text="{Binding Title}"
                                    FontSize="14"
                                    />
                                <TextBlock
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Margin="8,0"
                                    Opacity="0.6"
                                    >
                                    <Run Text="• " />
                                    <Run Text="{Binding Description}" />
                                </TextBlock>

                                <TextBlock 
                                    />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=ListView}}" Value="False">
                                <Setter TargetName="CompactLayout" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ListLayout" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource BackgroundLayer}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" RowDefinitions="*,*" ColumnDefinitions="*,Auto" Margin="0,8">
                        <TextBlock Grid.Row="0" Text="{Binding SelectedEntry.Title}" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1">
                            <TextBlock Text="{Binding SelectedEntry.Description}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" Margin="8">
                            <controls:AppButton
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE768;"
                        IconFontSize="13"
                        Height="26"
                        Width="26"
                        Padding="0"
                        ToolTip="Play all" 
                        Click="PlaySelectedPlaylist_click"
                        />
                            <controls:AppButton
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE8B1;"
                        IconFontSize="13"
                        Height="26"
                        Width="26"
                        Padding="0"
                        ToolTip="Shuffle" 
                        Click="ShufflePlaylist_click"
                        />
                            <controls:AppDropdownButton
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE712;"
                        IconFontSize="13"
                        Height="26"
                        Width="26"
                        Padding="0"
                        ToolTip="More" 
                        ShowIndicator="False"
                        Command="{Binding ShuffleAllTracksCommand}">
                                <controls:AppDropdownButton.Menu>
                                    <ContextMenu>
                                        <MenuItem Icon="{ex:Icon Glyph=E8B1}" Header="Randomize order"/>
                                        <Separator/>
                                        <MenuItem Icon="{ex:Icon Glyph=E70F}" Header="Edit"/>
                                        <MenuItem Icon="{ex:Icon Glyph=E74D}" Header="Remove"/>
                                    </ContextMenu>
                                </controls:AppDropdownButton.Menu>
                            </controls:AppDropdownButton>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundLayer}" Height="32">
                        <ListBox
                            Margin="90,0,0,0"
                            ItemsSource="{Binding AllTabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            BorderThickness="0"
                            Background="Transparent"
                            SelectionMode="Single"
                            HorizontalContentAlignment="Stretch">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBorder"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="2,2,0,0">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundControlHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundControlDefault}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.RowSpan="2"  Width="72" Height="72" CornerRadius="45" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Background>
                            <ImageBrush
                                ImageSource="{Binding SelectedEntry.ImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=150}"
                                />
                        </Border.Background>
                    </Border>

                </Grid>
                <Grid
                    Grid.Row="1" 
                    RowDefinitions="*"
                    Visibility="{Binding SelectedTab, Converter={StaticResource TabStringToVisibilityConverter}, ConverterParameter=Tracks}"
                    Margin="2,0"
                    >
                    <ScrollViewer
                        Grid.Row="0"
                        >
                        <controlsM:TracksView
                            x:Name="PlaylistTracksView"
                            Grid.Row="0"
                            ItemsSource="{Binding Tracks}"
                            AllTrackIds="{Binding AllTrackIds}"
                            SelectedTrackIds="{Binding SelectedTrackIds, Mode=TwoWay}"
                            VisualMode="ListImage"
                            IndexMode="ListIndex"
                            SelectionMode="Extended"
                            IsReorderEnabled="True"
                            IsMouseWheelScrollEnabled="False"
                            ReorderRequestedCommand="{Binding ReorderTrackCommand}"
                            RemoveRequestedCommand="{Binding RemoveSelectedTracksCommand}"
                            />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>



