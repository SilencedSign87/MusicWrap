<UserControl x:Class="MusicWrap.UI.Features.Library.Components.AlbumPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Library.Components"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Library.ViewModels"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:controlsM="clr-namespace:MusicWrap.UI.Controls.Models"
             xmlns:converters="clr-namespace:MusicWrap.UI.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:LibraryEntryAlbumViewModel}"
             d:DesignHeight="200" d:DesignWidth="160"
             Cursor="Hand">
    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
    </UserControl.Resources>
    <!-- Renders an album -->
    <Border 
        x:Name="RootBorder"
        Background="Transparent" 
        ToolTip="{Binding Title}"
        BorderThickness="0"
        CornerRadius="4"
        Margin="0"
        Padding="0"
        >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Album Cover -->
            <controls:SquarePanel Grid.Row="0">
                <Border CornerRadius="4">
                    <Border.Background>
                        <ImageBrush 
                            ImageSource="{Binding CoverImage}"
                            Stretch="Uniform"
                            AlignmentX="Center"
                            AlignmentY="Center"
                            />
                    </Border.Background>
                </Border>
            </controls:SquarePanel>
            <!-- Album Info -->
            <Border Grid.Row="1" 
                    Padding="2,4"
                    Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding Title}" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,2"
                               TextWrapping="NoWrap"/>
                    <TextBlock Grid.Row="1"
                               FontSize="11" 
                               TextAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ArtistNames}"
                               TextTrimming="CharacterEllipsis" 
                               TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>



