<UserControl x:Class="MusicWrap.UI.Features.Library.Views.LibraryEntryTracksView"
             x:Name="RootLibraryEntryTracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uimodels="clr-namespace:MusicWrap.UI.Controls.Models"
             xmlns:helpers="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Library.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryEntryTracksViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <uimodels:TracksView 
            x:Name="EntryTracksView"
            ItemsSource="{Binding Tracks}" Grid.Row="0"
            AllTrackIds="{Binding AllTrackIds}"
            SelectedTrackIds="{Binding SelectedTrackIds, Mode=TwoWay}"
            VisualMode="ListImage"
            IndexMode="ListIndex"
            SelectionMode="Extended"
            IsMouseWheelScrollEnabled="True"
            />
    </Grid>
</UserControl>
