<UserControl x:Class="MusicWrap.UI.Features.Library.Views.AlbumTracksPage"
         x:Name="RootAlbumTracksPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:local="clr-namespace:MusicWrap.UI.Features.Library.Views"
         xmlns:vm="clr-namespace:MusicWrap.UI.Features.Library.ViewModels"
         xmlns:uimodels="clr-namespace:MusicWrap.UI.Controls.Models"
         xmlns:helpers="clr-namespace:MusicWrap.UI.Helpers"
         xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
         xmlns:converters="clr-namespace:MusicWrap.UI.Converters"
         mc:Ignorable="d" 
         d:DataContext="{d:DesignInstance Type=vm:AlbumTracksViewModel}"
         d:DesignHeight="450" d:DesignWidth="800"
         Foreground="{Binding ForegroundColor}"
         Background="Transparent">
    <UserControl.Resources>
        <converters:ItemCountToColumnsConverter x:Key="ItemCountToColumnsConverter"/>
        <SolidColorBrush x:Key="DominantBrush" Color="{Binding DominantColor, ElementName=RootAlbumTracksPage}"/>
        <SolidColorBrush x:Key="DominantForegroundBrush" Color="{Binding ForegroundColor, ElementName=RootAlbumTracksPage}"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="{Binding HighlightColor, ElementName=RootAlbumTracksPage}"/>
        <SolidColorBrush x:Key="HighlightForegroundBrush" Color="{Binding HighlightForeground, ElementName=RootAlbumTracksPage}"/>

        <Style x:Key="AlbumTrackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding ForegroundColor}" />
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="4"
                            >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding ForegroundColor}"/>
                                <Setter Property="Foreground" Value="{Binding DominantColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Album Header -->
        <StackPanel Grid.Row="0" Margin="8,8,0,0">
            <StackPanel Margin="0,0,36,4">
                <TextBlock Text="{Binding AlbumTitle}" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="{Binding Foreground, ElementName=RootAlbumTracksPage}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" 
                           VerticalAlignment="Center"
                           Opacity="0.7">
                    <Run Text="{Binding AlbumArtists}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding AlbumYear}"/>
                </TextBlock>
                <controls:AppButton
                    Width="24" Height="24" Padding="0"
                    Icon="{Binding AlbumPlayGlyph}"
                    ToolTip="{Binding AlbumPlayTooltip}" 
                    Style="{StaticResource AlbumTrackButtonStyle}"
                    Click="PlayPauseAlbum_Click"
                    IconFontSize="13"
                    Margin="8,0,0,0"
                    />
                <controls:AppButton
                    Width="24" Height="24" Padding="0"
                    Icon="&#xE8B1;"
                    ToolTip="Shuffle"
                    Style="{StaticResource AlbumTrackButtonStyle}"
                    Click="ShuffleButton_Click"
                    IconFontSize="13"
                    />

            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="AlbumTracksTracksHost">
            <uimodels:TracksView 
                x:Name="AlbumTracksView"
                ItemsSource="{Binding Tracks}"
                AllTrackIds="{Binding AllTrackIds}"
                SelectedTrackIds="{Binding SelectedTrackIds, Mode=TwoWay}"
                GroupByDisk="True"
                UseColumnFlowPanel="True"
                VisualMode="CompactNoCover"
                Foreground="{Binding Foreground , ElementName=RootAlbumTracksPage}"
                SelectedForeground="{Binding HighlightForeground, Converter={StaticResource HexToBrushConverter}}"
                Background="Transparent"
                SelectedBackground="{Binding HighlightColor, Converter={StaticResource HexToBrushConverter}}"
                IndexMode="TrackNumber"
                SelectionMode="Extended">
                <uimodels:TracksView.ColumnFlowColumns>
                    <MultiBinding Converter="{StaticResource ItemCountToColumnsConverter}" ConverterParameter="10,500">
                        <Binding Path="Tracks.Count"/>
                        <Binding ElementName="AlbumTracksTracksHost" Path="ActualWidth"/>
                    </MultiBinding>
                </uimodels:TracksView.ColumnFlowColumns>
            </uimodels:TracksView>
        </Grid>
    </Grid>
</UserControl>



