<UserControl x:Class="MusicWrap.UI.Features.Library.Views.LibraryEntryDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Library.Views"
             xmlns:viewmodel="clr-namespace:MusicWrap.UI.Features.Library.ViewModels"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:contros="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d" 
              x:Name="RootDetailPanel"
             d:DataContext="{d:DesignInstance Type=viewmodel:LibraryEntryDetailPanelViewModel}"
             d:DesignHeight="800" d:DesignWidth="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" RowDefinitions="*,*" ColumnDefinitions="*,Auto" Margin="0,8">
                <TextBlock Grid.Row="0" Grid.Column="0"  Text="{Binding HeaderTitle}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="0">
                    <TextBlock Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="{Binding HeaderAlbumsCountText}"/>
                            <Run Text=" Albums"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding HeaderTracksCountText}"/>
                            <Run Text=" tracks"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding HeaderTotalDurationText}"/>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Margin="8">
                    <contros:AppButton
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE768;"
                        IconFontSize="13"
                        Height="26"
                        Width="26"
                        Padding="0"
                        ToolTip="Play all" 
                        Command="{Binding PlayAllTracksCommand}"
                        />
                    <contros:AppButton
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE8B1;"
                        IconFontSize="13"
                        Height="26"
                        Width="26"
                        Padding="0"
                        ToolTip="Shuffle" 
                        Command="{Binding ShuffleAllTracksCommand}"
                        />
                    <contros:AppDropdownButton
                        Style="{StaticResource SubtleButton}"
                        Icon="&#xE712;"
                        IconFontSize="13"
                        Height="26"
                        Width="26"
                        Padding="0"
                        ToolTip="More" 
                        ShowIndicator="False"
                        Command="{Binding ShuffleAllTracksCommand}">
                        <contros:AppDropdownButton.Menu>
                            <ContextMenu>
                                <MenuItem Icon="{ex:Icon Glyph=E70F}" Header="Edit"/>
                            </ContextMenu>
                        </contros:AppDropdownButton.Menu>
                    </contros:AppDropdownButton>
                </StackPanel>

            </Grid>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="32" Background="{DynamicResource BackgroundLayer}" Padding="90,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Workspace.Tabs}"
                                 SelectedItem="{Binding Workspace.SelectedTab, Mode=TwoWay}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionMode="Single"
                                 HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabBorder"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="2,2,0,0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundControlHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundControlDefault}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Column="1">
                       
                    </Grid>
                </Grid>
            </Border>

            <Border Width="72" Height="72" Grid.RowSpan="2" CornerRadius="36" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Border.Background>
                    <ImageBrush ImageSource="{Binding HeaderImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=medium:72}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                </Border.Background>
            </Border>

        </Grid>
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <local:LibraryEntryAlbumsView
                DataContext="{Binding AlbumEntriesViewModel}"
                Visibility="{Binding Workspace.IsAlbumsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <local:LibraryEntryTracksView
                DataContext="{Binding TracksViewModel}"
                Visibility="{Binding Workspace.IsTracksTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
