<UserControl x:Class="MusicWrap.UI.Features.Playback.Views.NowPlayingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Playback.Views"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Playback.ViewModels"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NowPlayingViewModel}"
             Foreground="{Binding ForegroundColorHex}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="RootNowPlaying"
             >
    <UserControl.Background>
        <ImageBrush 
            ImageSource="{Binding TrackImagePath , Converter={StaticResource PathToImageConverter}, ConverterParameter=blur}" 
            RenderOptions.BitmapScalingMode="HighQuality"
            Opacity="0.8"
            Stretch="UniformToFill"/>
    </UserControl.Background>
    <UserControl.ContextMenu>
        <ContextMenu Foreground="{DynamicResource TextPrimaryBrush}">
            <MenuItem Header="Lyrics" Icon="{ex:Icon Glyph=&#xEC4F;}">
                <MenuItem Header="Show" IsCheckable="True" />
                <MenuItem Header="Sync" IsCheckable="True" />
                <Separator />
                <MenuItem Header="Search..." />
            </MenuItem>
            <MenuItem Header="Visualizer" Icon="{ex:Icon Glyph=&#xF61F;}">
                <MenuItem Header="Lines" IsCheckable="True" />
                <MenuItem Header="Gradient" IsCheckable="True" />
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Grid>
        <Grid ColumnDefinitions="500,*" RowDefinitions="*,Auto" HorizontalAlignment="Center" Width="Auto">
            <!-- Main View -->
            <Border Grid.Column="0" Grid.Row="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="4" Width="400" Height="400" Margin="0,0,0,16">
                        <Border.Background>
                            <ImageBrush
                            ImageSource="{Binding TrackImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=large:400}"
                                Stretch="UniformToFill"
                            />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect
                            BlurRadius="16"
                            Direction="270"
                            Opacity="0.5"
                            />
                        </Border.Effect>
                    </Border>
                    <Grid>

                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding TrackTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Style="{StaticResource TransparentButton}" Foreground="{Binding Foreground, ElementName=RootNowPlaying}" HorizontalAlignment="Center" Padding="0">
                                <TextBlock Text="{Binding TrackAlbum}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <ItemsControl ItemsSource="{Binding TrackArtists}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                        Style="{StaticResource TransparentButton}"
                                        Foreground="{Binding Foreground, ElementName=RootNowPlaying}"
                                        Content="{Binding Name}"
                                        FontSize="12"
                                        Padding="0"
                                        Margin="0,0,2,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>


                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Lyrics View -->
            <Border Grid.Column="1" Grid.Row="0">

            </Border>
        </Grid>
        <!-- Visualizer -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <controls:BarVisualizerControl
                HorizontalAlignment="Stretch"
                Height="120"
                BarCount="120"
                Opacity="0.5"
                />
        </Border>
    </Grid>
</UserControl>


