<UserControl x:Class="MusicWrap.UI.Features.Playback.Views.NowPlayingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Playback.Views"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Playback.ViewModels"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:lyrics="clr-namespace:MusicWrap.UI.Features.Lyrics.View"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NowPlayingViewModel}"
             Foreground="{Binding ForegroundColorHex}"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="RootNowPlaying"
             >
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="0,4,0,6">
            <controls:AppMenu HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}">
                <controls:AppMenuItem Icon="{ex:Icon Glyph=E8A7,FontSize=12}" Header="Properties" Command="{Binding OpenPropertiesCommand}" IsCheckable="False" />
                <Separator/>
                <controls:AppMenuItem Header="Panels" Icon="{ex:Icon Glyph=ECA5,FontSize=12}">
                    <controls:AppMenuItem Header="Lyrics" Icon="{ex:Icon Glyph=EC4F}" IsCheckable="True" IsChecked="{Binding ShowLyrics}" />
                    <controls:AppMenuItem Header="Visualizer" Icon="{ex:Icon Glyph=F61F,FontSize=12}" >
                        <controls:AppMenuItem Header="Hide" IsCheckable="True" 
                            Command="{Binding SetVisualizerCommand}"
                            CommandParameter="None"
                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=None}"
                            />
                        <Separator/>
                        <controls:AppMenuItem Header="Line" IsCheckable="True" 
                            Command="{Binding SetVisualizerCommand}"
                            CommandParameter="LineSpectrum"
                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=LineSpectrum}" />
                        <controls:AppMenuItem Header="Bars" IsCheckable="True" 
                            Command="{Binding SetVisualizerCommand}"
                            CommandParameter="BarSpectrum"
                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=BarSpectrum}" />
                        <controls:AppMenuItem Header="Wave" IsCheckable="True" 
                            Command="{Binding SetVisualizerCommand}"
                            CommandParameter="MirroredBarSpectrum"
                            IsChecked="{Binding PreferredVisualizer, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=MirroredBarSpectrum}" />
                        <Separator/>
                        <controls:AppMenuItem Header="Spectrum" IsCheckable="True"
                                  Command="{Binding SetSpectrumTypeCommand}"
                                  CommandParameter="Normal"
                                  IsChecked="{Binding PreferredSpectrumType, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=Normal}"
                                  />
                        <controls:AppMenuItem Header="Centered" IsCheckable="True"
                                  Command="{Binding SetSpectrumTypeCommand}"
                                  CommandParameter="Centered"
                                  IsChecked="{Binding PreferredSpectrumType, Converter={StaticResource EnumComparisonConverter}, ConverterParameter=Centered}"
                                  />
                    </controls:AppMenuItem>
                </controls:AppMenuItem>
                <controls:AppMenuItem  Header="Artwork blur" Icon="{ex:Icon Glyph=E794}" IsCheckable="True" IsChecked="{Binding BlurEffect}" />
            </controls:AppMenu>
        </Border>

        <Grid Grid.Row="1" x:Name="NowPlayingLayout" SizeChanged="OnNowPlayingLayoutSizeChanged">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Background">
                        <Setter.Value>
                            <ImageBrush ImageSource="{Binding TrackImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=blur}"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Opacity="1" 
                        AlignmentX="Center"
                        AlignmentY="Center"
                        Stretch="UniformToFill"
                        />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BlurEffect}" Value="False">
                            <Setter Property="Background" Value="{Binding DominantColorHex}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="*"/>
                <ColumnDefinition x:Name="LyricsColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ArtworkRow" Height="*"/>
                <RowDefinition x:Name="LyricsRow" Height="0"/>
                <RowDefinition x:Name="VisualizerRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Artwork -->
            <controls:SquarePanel x:Name="ArtworkHost"
                      Grid.Row="0" Grid.Column="0">
                <Image
                Source="{Binding TrackImagePath, Converter={StaticResource PathToImageConverter}, ConverterParameter=original:1080}"
                Stretch="UniformToFill"
                
                />
            </controls:SquarePanel>
            <!-- Lyrics -->
            <Border x:Name="LyricsHost"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <lyrics:LyricsView
                    x:Name="lyricsComponent"
                    AllowSeek="True"
                    FontSize="16"
                    LyricsStateChanged="lyricsComponent_LyricsStateChanged"
                    LyricsPadding="12,20"
                    />
            </Border>

            <!-- Visualizer -->
            <Border x:Name="VisualizerHost"
            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
            Visibility="{Binding IsVisualizerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:SpectrumVisualizerControl
                    HorizontalAlignment="Stretch"
                    Visualizer="{Binding PreferredVisualizer}"
                    SpectrumType="{Binding PreferredSpectrumType}"
                    Height="120" 
                    BarCount="128" 
                    Opacity="0.5"
                    />
            </Border>
        </Grid>
    </Grid>
</UserControl>


