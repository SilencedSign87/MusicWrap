<UserControl x:Class="MusicWrap.UI.Features.Playback.Views.QueueListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicWrap.UI.Features.Playback.Views"
             xmlns:ex="clr-namespace:MusicWrap.UI.Helpers"
             xmlns:controls="clr-namespace:MusicWrap.UI.Controls"
             xmlns:controlsM="clr-namespace:MusicWrap.UI.Controls.Models"
             xmlns:vm="clr-namespace:MusicWrap.UI.Features.Playback.ViewModels"
             mc:Ignorable="d"
             x:Name="QueueRoot"
             d:DataContext="{d:DesignInstance Type=vm:QueueViewModel}"
             d:DesignHeight="700" d:DesignWidth="500">

    <UserControl.Resources>
        <SolidColorBrush x:Key="LocalStroke" Color="{Binding Foreground.Color, ElementName=QueueRoot}" Opacity="0.2" />
        
        <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}" x:Key="queueButtonStyle">
            <Setter Property="Foreground" Value="{Binding Foreground, ElementName=QueueRoot}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, ElementName=QueueRoot}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border 
            Grid.Row="0" 
            Padding="0,4"
            BorderThickness="0,0,0,1"
            BorderBrush="{StaticResource LocalStroke}"
            Height="42"
            >
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowToolbar, ElementName=QueueRoot}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton
                    Style="{StaticResource queueButtonStyle}" 
                    Command="{Binding SaveAsPlaylistCommand}"
                    Icon="&#xE74E;"
                    Text="Save as playlist"
                    />
                <controls:AppButton
                    Margin="8,0" 
                    Style="{StaticResource queueButtonStyle}" 
                    Command="{Binding ClearQueueCommand}"
                    Icon="&#xEA99;"
                    Text="Clear"
                    />
            </StackPanel>
        </Border>
        <controlsM:TracksView
            x:Name="QueueTracksView"
            Grid.Row="1"
            ItemsSource="{Binding QueueTrackRows}"
            SelectedTrackIds="{Binding SelectedTrackIds, Mode=TwoWay}"
            VisualMode="WithCoverArt"
            IndexMode="None"
            SelectionMode="Extended"
            IsMouseWheelScrollEnabled="True"
            AutoScrollToCurrentTrack="True"
            IsReorderEnabled="True"
            ReorderRequestedCommand="{Binding ReorderTrackCommand}"
            TrackActivatedCommand="{Binding ActivateTrackCommand}"/>
    </Grid>
</UserControl>



